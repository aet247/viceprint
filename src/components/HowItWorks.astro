---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---

<section id="how">
  <!-- TODO confirm with supplier (spec §4/§11): print time "roughly 15 seconds a nail", cure time "under a minute" -->
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{text.steps.eyebrow}</span>
      <h2>{text.steps.heading}</h2>
    </div>
    <div class="steps">
      {text.steps.items.map((item, i) => (
        <div class="step reveal"><div class="step-num">0{i + 1}</div><h3>{item.title}</h3><p>{item.text}</p></div>
      ))}
    </div>
  </div>
</section>
