---
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="reveal in">
      <span class="eyebrow">Founder presale — first batch, Europe</span>
      <h1>Full nail art, printed while they wait.</h1>
      <p class="hero-sub">The digital printer built for studios. No specialist needed for the detail work, no limit on the design library — from french tips to full illustrations, done in seconds.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#pricing">Reserve your unit</a>
        <a class="btn btn-ghost" href="#contact">Book a demo call</a>
      </div>
      <p class="hero-note">50% deposit or full prepay · refundable until it ships</p>
    </div>
    <div class="print-demo reveal in" aria-hidden="true">
      <svg viewBox="0 0 220 280" width="240" height="300">
        <defs>
          <linearGradient id="nailGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7B2FF7"/>
            <stop offset="1" stop-color="#FF2E92"/>
          </linearGradient>
          <clipPath id="nailClip">
            <path d="M110 8C60 8 34 54 34 132c0 78 30 138 76 138s76-60 76-138C186 54 160 8 110 8Z"/>
          </clipPath>
        </defs>
        <path d="M110 8C60 8 34 54 34 132c0 78 30 138 76 138s76-60 76-138C186 54 160 8 110 8Z" fill="url(#nailGrad)"/>
        <g clip-path="url(#nailClip)">
          <rect class="scan-bar" x="0" y="-40" width="220" height="40" fill="#00D4B8" opacity=".9"/>
        </g>
      </svg>
    </div>
  </div>
</section>
