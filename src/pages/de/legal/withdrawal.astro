---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Reservierung stornieren — VICEPRINT" description="Stornieren Sie Ihre VICEPRINT-Reservierung — Erstattung am selben Tag." locale="de">
  <div class="legal-page wrap">

    <h1>Reservierung stornieren</h1>
    <p>Stornieren Sie Ihre Reservierung — die Erstattung wird am selben Tag eingeleitet. Beide Tarife sind bis zum Versand voll erstattbar.</p>
    <p>Geben Sie die E-Mail-Adresse ein, mit der Sie reserviert haben, sowie die Referenz aus Ihrer Bestätigungs-E-Mail.</p>
    <form class="legal-form" id="withdrawal-form" novalidate>
      <div class="field">
        <label for="withdrawal-email">E-Mail</label>
        <input id="withdrawal-email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="withdrawal-reference">Reservierungsreferenz</label>
        <input id="withdrawal-reference" type="text" autocomplete="off" required />
      </div>
      <button class="btn btn-primary" type="submit">Stornierung anfordern</button>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('withdrawal-form')!;
  const email = document.getElementById('withdrawal-email') as HTMLInputElement;
  const reference = document.getElementById('withdrawal-reference') as HTMLInputElement;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const emailVal = email.value.trim();
    const refVal = reference.value.trim();
    if (!emailVal || !refVal) {
      (window as any).showToast?.("Bitte E-Mail und Reservierungsreferenz angeben.");
      return;
    }
    if (!EMAIL_RE.test(emailVal)) {
      (window as any).showToast?.("Bitte eine gültige E-Mail-Adresse eingeben.");
      return;
    }
    fetch('/api/reservation', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'cancel', email: emailVal, reference: refVal }),
    })
      .then(async (res) => {
        const data = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
        if (res.ok && data?.ok) {
          (window as any).showToast?.('Stornierung erhalten — Ihre Erstattung wird bearbeitet. Eine Bestätigungs-E-Mail ist unterwegs.');
        } else {
          (window as any).showToast?.(data?.error ?? 'Stornierung fehlgeschlagen — bitte erneut versuchen oder uns kontaktieren.');
        }
      })
      .catch(() => (window as any).showToast?.('Stornierung fehlgeschlagen — bitte erneut versuchen oder uns kontaktieren.'));
  });
</script>
