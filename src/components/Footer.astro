---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const text = t(locale);
const footer = text.footer;

const settingsFiles = import.meta.glob('../../content/site-settings.json', { eager: true, import: 'default' });
const data = Object.values(settingsFiles)[0] as
  | { businessEmail?: string; compliance?: { weeeNumber?: string; gpsrPerson?: { name?: string; address?: string } } }
  | undefined;
const weeeNumber = data?.compliance?.weeeNumber?.trim() ?? '';
const gpsrName = data?.compliance?.gpsrPerson?.name?.trim() ?? '';
const gpsrAddress = data?.compliance?.gpsrPerson?.address?.trim() ?? '';
const businessEmail = data?.businessEmail?.trim() ?? '';
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-cols">
        <div class="footer-col">
          <h4>{footer.company}</h4>
          <a href="#audience">{footer.audienceLink}</a>
          <a href="#contact">{footer.contactLink}</a>
          {businessEmail && <a href={`mailto:${businessEmail}`}>{businessEmail}</a>}
        </div>
        <div class="footer-col">
          <h4>{footer.legal}</h4>
          <a href="/legal/privacy">{footer.privacy}</a>
          <a href="/legal/terms">{footer.terms}</a>
          <a href="/legal/impressum">{footer.impressum}</a>
          <a href="/legal/cookies">{footer.cookies}</a>
          <a href="/legal/withdrawal">{footer.withdrawal}</a>
        </div>
      </div>
      {weeeNumber && (
        <p class="compliance-note">WEEE registration: {weeeNumber}</p>
      )}
      {gpsrName && (
        <p class="compliance-note">Responsible person (GPSR): {gpsrName}, {gpsrAddress}</p>
      )}
    </div>
    <div class="footer-bottom">
      <span set:html={footer.bottom.replace('{year}', '<span id="year"></span>')} />
      <span>{footer.specsNote}</span>
    </div>
  </div>
</footer>

<script>
  document.getElementById('year')!.textContent = String(new Date().getFullYear());
</script>
