---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---
<section id="showcase">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{text.showcase.eyebrow}</span>
      <h2>{text.showcase.heading}</h2>
      <p>{text.showcase.sub}</p>
    </div>
    <div class="gallery reveal">
      {text.showcase.tiles.map((tile, i) => (
        <div class={`tile t${i + 1}`}><span>{tile}</span></div>
      ))}
    </div>
  </div>
</section>
