---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';
import ReservationButtons from '@/components/ReservationButtons.tsx';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = t(locale).pricing;
---
<section id="pricing">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2>{p.heading}</h2>
      <p>{p.sub}</p>
    </div>
    <p class="anchor-price reveal">{p.anchor.label} <s>{p.anchor.strike}</s> {p.anchor.glue} <strong>{p.anchor.em}</strong></p>
    <div class="price-grid reveal">
      <div class="price-card">
        <h3>{p.reserve.name}</h3>
        <p class="tier-note">{p.reserve.note}</p>
        <p class="price-num">{p.reserve.price}</p>
        <p class="price-fine">{p.reserve.fine}</p>
        <div class="price-includes">
          <strong>{p.reserve.includesLabel}</strong>
          {p.reserve.includes}
        </div>
        <ReservationButtons tier="reserve" locale={locale} client:load />
      </div>
      <div class="price-card featured">
        <span class="badge">{p.founder.badge}</span>
        <h3>{p.founder.name}</h3>
        <p class="tier-note">{p.founder.note}</p>
        <p class="price-num">{p.founder.price}</p>
        <p class="price-fine">{p.founder.fine}</p>
        <div class="price-includes">
          <strong>{p.founder.includesLabel}</strong>
          {p.founder.includes}
        </div>
        <ReservationButtons tier="founder" locale={locale} client:load />
      </div>
    </div>
  </div>
</section>
