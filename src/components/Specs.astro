---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';
import specs from '@/../content/specs.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---
<section id="specs">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{text.specs.eyebrow}</span>
      <h2>{text.specs.heading}</h2>
      <p>{text.specs.sub}</p>
    </div>
    <table class="spec-table reveal">
      {specs.rows.map((row) => (
        <tr>
          <td>{row.label}</td>
          <td>{row.value}{row.confirmed === false && <span class="tbd">TBD</span>}</td>
        </tr>
      ))}
    </table>
  </div>
</section>
