---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const text = t(locale);
const footer = text.footer;

const settingsFiles = import.meta.glob('../../content/site-settings.json', { eager: true, import: 'default' });
const data = Object.values(settingsFiles)[0] as { compliance?: Record<string, string> } | undefined;
const compliance = data?.compliance;
const complianceValues = Object.values(compliance ?? {}).map(v => v.trim()).filter(Boolean);
const hasCompliance = complianceValues.length > 0;
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-cols">
        <div class="footer-col">
          <h4>{footer.company}</h4>
          <a href="#audience">{footer.audienceLink}</a>
          <a href="#contact">{footer.contactLink}</a>
        </div>
        <div class="footer-col">
          <h4>{footer.legal}</h4>
          <a href="/legal/privacy">{footer.privacy}</a>
          <a href="/legal/terms">{footer.terms}</a>
          <a href="/legal/impressum">{footer.impressum}</a>
          <a href="/legal/cookies">{footer.cookies}</a>
          <a href="/legal/withdrawal">{footer.withdrawal}</a>
        </div>
      </div>
      {hasCompliance && (
        <p class="compliance-note">{complianceValues.join(' · ')}</p>
      )}
    </div>
    <div class="footer-bottom">
      <span set:html={footer.bottom.replace('{year}', '<span id="year"></span>')} />
      <span>{footer.specsNote}</span>
    </div>
  </div>
</footer>

<script>
  document.getElementById('year')!.textContent = String(new Date().getFullYear());
</script>
