---
---
<section id="pricing">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">Founder presale</span>
      <h2>Reserve the first batch</h2>
      <p>A deposit or a full prepay — either way, fully refundable until your unit ships.</p>
    </div>
    <p class="anchor-price reveal">Regular price <s>€2,199</s> — founder price <strong>€1,499</strong></p>
    <div class="price-grid reveal">
      <div class="price-card">
        <h3>Reserve</h3>
        <p class="tier-note">50% deposit today</p>
        <p class="price-num">€750</p>
        <p class="price-fine">€749 balance before shipping · refundable any time before then</p>
        <div class="price-includes">
          <strong>Includes</strong>
          Starter kit — 2 ink cartridges + carry case
        </div>
        <!-- TODO (step 09): replace stub with PayPal island mounted on #paypal-reserve -->
        <button class="btn btn-ghost" id="paypal-reserve" data-reserve data-tier="reserve">Reserve with 50%</button>
      </div>
      <div class="price-card featured">
        <span class="badge">Best value</span>
        <h3>Founder</h3>
        <p class="tier-note">100% prepay today</p>
        <p class="price-num">€1,499</p>
        <p class="price-fine">Nothing more to pay · refundable until shipped</p>
        <div class="price-includes">
          <strong>Includes</strong>
          Full consumables kit, 2-year warranty, 1:1 onboarding call, priority first-batch shipping
        </div>
        <!-- TODO (step 09): replace stub with PayPal island mounted on #paypal-founder -->
        <button class="btn btn-primary" id="paypal-founder" data-reserve data-tier="founder">Reserve as Founder</button>
      </div>
    </div>
  </div>
</section>
