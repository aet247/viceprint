---
import type { Locale } from '@/i18n/t';
import { t } from '@/i18n/t';
import shipDateFaq from '@/../content/faq/ship-date.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);

const settingsFiles = import.meta.glob('../../content/site-settings.json', { eager: true, import: 'default' });
const siteSettings = Object.values(settingsFiles)[0] as { shipWindow?: string } | undefined;
const shipWindow = siteSettings?.shipWindow?.trim() ?? '';
const shipDateQuestion = shipDateFaq.question;
const entries = text.faq.entries.map((faq) =>
  shipWindow && faq.q === shipDateQuestion ? { ...faq, a: shipWindow } : faq,
);
---
<!-- TODO confirm with supplier (spec §4/§11): ink-safety answer claims "Cosmetic-grade ink and CE-certified hardware" — ink certification + CE cert are unconfirmed -->
<section id="faq">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{text.faq.eyebrow}</span>
      <h2>{text.faq.heading}</h2>
    </div>
    <div class="faq-list reveal">
      {entries.map((faq) => (
        <details>
          <summary>
            {faq.q}
            <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <p set:html={faq.a} />
        </details>
      ))}
    </div>
  </div>
</section>
