# Build-time (public, baked into client bundle)
PUBLIC_PAYPAL_CLIENT_ID=

# Server-side secrets live in Cloudflare Pages, NEVER in this file or git.
# Set via: printf '%s' "$VAR" | npx wrangler pages secret put $VAR --project-name viceprint
# Then REDEPLOY — Pages snapshots secrets at deploy time.
# PAYPAL_CLIENT_ID (the server-side pair of PUBLIC_PAYPAL_CLIENT_ID) lives in
# wrangler.toml [vars].
PAYPAL_SECRET=
RESEND_API_KEY=
BUSINESS_EMAIL=
PAYPAL_ENV=sandbox
